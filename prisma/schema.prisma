generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  avatar           String?
  phone            String?
  userType         String   @default("disabled")  // disabled=残疾人, able-bodied=健全人
  communityBalance Float    @default(0)            // 共同体账户余额
  investmentPoints Float    @default(0)            // 投资点数
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdProjects  Project[]
  donations        Donation[]
  namedLedgers     NamedLedger[]
  comments         Comment[]
  communityAccounts CommunityAccount[]
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  icon        String?
  projects    Project[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String
  targetAmount Float
  currentAmount Float  @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  status      String   @default("pending")
  images      String?
  location    String?
  organizer   String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  donations   Donation[]
  donorCount  Int      @default(0)
  comments    Comment[]
  documents   ProjectDocument[]
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  message   String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  donorId   String
  donor     User     @relation(fields: [donorId], references: [id])
}

// ============================================
// 评论系统
// ============================================

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

// ============================================
// 项目文档系统
// ============================================

model ProjectDocument {
  id        String   @id @default(cuid())
  docType   String   // 文档类型
  content   String?  // 文档内容
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

// ============================================
// 记名账本系统 - Named Ledger
// ============================================
// 账本类型：technology/technique/public_tool/intelligence/energy/charity/donation/volunteer/time/deposit/cooperation/dream/reality/medical

model NamedLedger {
  id          String   @id @default(cuid())
  ledgerType  String   // 账本类型
  content     String   // 内容描述
  value       Float    @default(0)  // 价值评分
  status      String   @default("pending")  // pending/confirmed/rejected
  specialData String?  // JSON格式特殊数据
  tags        String?  // JSON格式标签
  privacy     String   @default("private")  // private/public
  projectId   String?  // 关联项目ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

// ============================================
// 共同体账户系统 - Community Account
// ============================================

model CommunityAccount {
  id             String   @id @default(cuid())
  accountType    String   // balance=余额, investment=投资
  amount         Float    @default(0)
  reason         String?  // 变动原因
  transactionType String  // credit=收入, debit=支出
  createdAt      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

// ============================================
// 创新创意归档分类系统 - Innovation Archive
// ============================================

model Idea {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?

  // 分类向量特征
  layer       String   @default("DRAFT")
  maturity    String   @default("DRAFT")
  domain      String?
  subDomain   String?

  // 向量化特征
  featureVector String?
  keywords    String?

  // 优先级与紧急度
  priority    Int      @default(5)
  urgency     Int      @default(5)
  effort      Int      @default(5)

  // 依赖与被依赖
  sourceRelations IdeaRelation[] @relation("SourceIdea")
  targetRelations IdeaRelation[] @relation("TargetIdea")

  // 标签
  tagRelations  IdeaTagRelation[]

  // 状态
  isArchived  Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  blockReason String?

  // 时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联项目
  projectId   String?
}

model IdeaRelation {
  id           String   @id @default(cuid())
  type         String

  sourceIdeaId String
  sourceIdea   Idea     @relation(fields: [sourceIdeaId], references: [id], name: "SourceIdea")
  targetIdeaId String
  targetIdea   Idea     @relation(fields: [targetIdeaId], references: [id], name: "TargetIdea")

  strength     Float    @default(0.5)
  description  String?
  distance     Float?

  createdAt    DateTime @default(now())
}

model IdeaTag {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?
  color       String?
  description String?

  ideas       IdeaTagRelation[]
  createdAt   DateTime @default(now())
}

model IdeaTagRelation {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  tagId     String
  tag       IdeaTag  @relation(fields: [tagId], references: [id])
  weight    Float    @default(1.0)

  createdAt DateTime @default(now())

  @@unique([ideaId, tagId])
}

// ============================================
// 活体架构系统 - Living Architecture
// ============================================

// 错误日志 - 消化系统的排泄物（肛门排出的记录）
model ErrorLog {
  id          String   @id @default(cuid())
  grade       String   // noise=放屁, known=正常排便, critical=拉肚子
  message     String   // 人类可读的错误描述（不暴露技术细节）
  raw         String?  // 原始错误信息（仅开发环境可见）
  source      String   // 发生源
  handled     Boolean  @default(false)
  suggestion  String?  // 恢复建议
  userId      String?  // 关联用户
  extra       String?  // JSON格式附加数据
  createdAt   DateTime @default(now())
}

// 志愿者节点 - 别人出服务器，我们出软件
model VolunteerNode {
  id            String   @id @default(cuid())
  name          String   // 节点名称
  url           String   // 服务器地址
  description   String?  // 节点描述
  providedBy    String   // 志愿者名称
  contactInfo   String?  // 联系方式
  nodeType      String   @default("full")  // api/relay/compute/storage/full
  status        String   @default("pending")  // pending/active/offline/rejected
  lastHeartbeat DateTime? // 最后心跳时间
  uptime        Float    @default(0)  // 在线率百分比
  region        String?  // 节点所在地区
  capabilities  String?  // JSON格式能力列表
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 云端同步配置 - 持久化到数据库而不是内存
model CloudSyncConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique  // 配置键名（如 github-token, webdav-url 等）
  configValue String   // 配置值（敏感信息加密存储）
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// 同步数据版本 - 用于冲突解决
model SyncVersion {
  id          String   @id @default(cuid())
  dataKey     String   @unique  // 数据键名
  version     Int      @default(1)  // 版本号
  lastSyncAt  DateTime @default(now())
  checksum    String?  // 数据校验和
  source      String?  // 数据来源（github/webdav/local）
}

// 设备身份 - 本地优先身份系统
model DeviceIdentity {
  id          String   @id @default(cuid())
  deviceId    String   @unique  // 设备唯一标识
  name        String?  // 用户昵称
  avatar      String?  // 头像
  userType    String   @default("disabled")  // disabled/able-bodied
  bio         String?  // 个人简介
  location    String?  // 所在地
  isVerified  Boolean  @default(false)  // 是否已验证
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 多巴胺记录 - 做善事后分泌的奖励
model DopamineRecord {
  id              String   @id @default(cuid())
  userId          String   // 行为主体
  actionType      String   // donate/create_project/volunteer/help/share/comment/verify
  actionDesc      String?  // 行为描述
  targetId        String?  // 行为对象（项目ID等）

  // 五维评分
  kindness        Float    @default(0)    // 善良 30%
  compassion      Float    @default(0)    // 恻隐 25%
  justice         Float    @default(0)    // 正义 20%
  dedication      Float    @default(0)    // 奉献 15%
  severity        Float    @default(0)    // 严重度 10%（反向）
  totalScore      Float    @default(0)    // 加权总分

  dopamineValue   Float    @default(0)    // 多巴胺值 = 总分 * 行为权重
  actionData      String?  // JSON格式行为数据

  createdAt       DateTime @default(now())
}

// ============================================
// 德系五十四模块系统 - Dexi 54 Modules
// ============================================

model DexiModule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  fullName    String
  category    String
  description String
  icon        String
  color       String
  features    String   // JSON string
  status      String   @default("active")
  priority    Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     DexiRecord[]
}

model DexiRecord {
  id         String   @id @default(cuid())
  moduleCode String
  module     DexiModule @relation(fields: [moduleCode], references: [code])
  userId     String?
  title      String
  content    String   // JSON string - flexible per module
  value      Float    @default(0)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// 道德股权系统 - Moral Equity System
// ============================================
// 核心思想：道德行为定义价值，完成任务积攒道德股权
// 所有术语可自定义（不硬编码"积分"等词汇）

// 道德股权余额 — 每个用户的道德价值总量
model MoralEquity {
  id            String   @id @default(cuid())
  userId        String   @unique
  totalEquity   Float    @default(0)    // 道德股权总值（由完成任务累积）
  level         Int      @default(1)    // 等级
  tier          String   @default("初善")  // 品阶
  totalTasks    Int      @default(0)    // 完成任务总数
  streakDays    Int      @default(0)    // 连续打卡天数
  lastActiveAt  DateTime?              // 最后活跃时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 道德任务定义 — 管理者可创建的日常/周常/一次性任务
model MoralTask {
  id            String   @id @default(cuid())
  code          String   @unique        // 任务代码
  name          String                  // 任务名称
  description   String                  // 任务描述
  category      String                  // 任务分类：daily/weekly/one-time/special
  moralValue    Float    @default(10)   // 完成可获得的道德值
  difficulty    String   @default("easy") // easy/medium/hard/legendary
  frequency     String   @default("daily") // daily/weekly/monthly/one-time
  isActive      Boolean  @default(true)
  conditions    String?  // JSON — 完成条件定义
  rewards       String?  // JSON — 奖励定义（可含额外五维加成）
  icon          String?  // 图标
  color         String?  // 颜色
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completions   MoralTaskCompletion[]
}

// 任务完成记录 — 用户完成道德任务的凭证
model MoralTaskCompletion {
  id              String    @id @default(cuid())
  taskId          String
  task            MoralTask @relation(fields: [taskId], references: [id])
  userId          String
  moralValueEarned Float   @default(0)   // 本次获得的道德值
  fiveDimScore    String?  // JSON — 本次五维评分
  proof           String?  // JSON — 完成凭证（图片/文字/链接）
  note            String?  // 用户备注
  status          String   @default("confirmed") // pending/confirmed/rejected
  reviewedBy      String?  // 审核人
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
}

// 词汇管理 — 所有可自定义术语的定义与存储
// 核心设计：不硬编码"积分"等词汇，由管理者通过此表自定义
model MoralVocabulary {
  id            String   @id @default(cuid())
  vocabKey      String   @unique       // 词汇键名（如 value_unit, action_donate）
  defaultValue  String                  // 默认值（如"德值"）
  customValue   String?                 // 管理者自定义值（如"善点"、"功德"）
  category      String                  // 词汇分类（见下方分类定义）
  description   String                  // 词汇说明（什么语境下使用）
  scope         String   @default("global") // global/module — 全局还是模块级别
  moduleCode    String?                 // 如果scope=module，关联的德系模块
  isCustomized  Boolean  @default(false)    // 是否已被管理者修改
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 词汇导入日志 — 记录每次词汇资源的导入操作
model VocabImportLog {
  id            String   @id @default(cuid())
  source        String                  // json/csv/manual/api
  fileName      String?                 // 来源文件名
  recordCount   Int      @default(0)    // 导入词汇数
  successCount  Int      @default(0)    // 成功数
  failCount     Int      @default(0)    // 失败数
  errors        String?  // JSON — 错误详情
  importedBy    String?                 // 导入者
  status        String   @default("completed") // processing/completed/failed
  createdAt     DateTime @default(now())
}

// ============================================
// 插板系统 - Plug-Socket Board System
// ============================================
// 核心设计：一切资源都是插头/插槽，型号匹配才能插入
// 词汇是插头、UI是插头、数据是插头、行为是插头
// 显示位是插槽、渲染位是插槽、输入位是插槽、处理位是插槽
// 神经系统负责信号路由——插头插入插槽，信号自动流通

// 插头型号 — 定义一类插头的规格（如"词汇插头"是两孔圆插头）
model PlugType {
  id          String   @id @default(cuid())
  code        String   @unique        // vocab/ui/data/action/signal/style/config
  name        String                  // 词汇插头/UI插头/数据插头...
  description String
  pinCount    Int      @default(1)    // 引脚数量（接口参数个数）
  pinDefs     String?  // JSON — 引脚定义 [{name, type, required, description}]
  icon        String?
  color       String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  plugs       Plug[]
}

// 插槽型号 — 定义一类插槽的规格（如"词汇插槽"是两孔圆插座）
model SocketType {
  id            String   @id @default(cuid())
  code          String   @unique    // vocab_display/ui_render/data_input/action_handler/signal_channel/style_apply/config_read
  name          String
  description   String
  pinCount      Int      @default(1) // 期望引脚数
  pinDefs       String?  // JSON — 期望的引脚定义
  icon          String?
  color         String?
  isSystem      Boolean  @default(true)
  createdAt     DateTime @default(now())
  sockets       Socket[]
  compatRules   CompatibleRule[]
}

// 兼容规则 — 哪种插头型号可以插入哪种插槽型号（转接头定义）
model CompatibleRule {
  id             String   @id @default(cuid())
  plugTypeCode   String                 // 插头型号code
  socketTypeCode String                 // 插槽型号code
  socketType     SocketType @relation(fields: [socketTypeCode], references: [code])
  transform      String?  // JSON — 插头值→插槽值的转换规则
  priority       Int      @default(0)  // 多个兼容时选最高优先级
  description    String?  // 为什么能兼容
  createdAt      DateTime @default(now())

  @@unique([plugTypeCode, socketTypeCode])
}

// 插头 — 实际的插头实例（每个词汇项、UI组件都是一个插头）
model Plug {
  id            String   @id @default(cuid())
  code          String   @unique       // 唯一标识（如 vocab_value_unit, ui_five_dim_radar）
  name          String                 // 插头名称
  description   String?
  plugTypeCode  String                 // 插头型号
  plugType      PlugType @relation(fields: [plugTypeCode], references: [code])
  provider      String                 // 提供者模块（如 moral-vocabulary, dopamine, dexi）
  pinValues     String?  // JSON — 引脚值（插头携带的数据/配置）
  isActive      Boolean  @default(true)
  sourceModule  String?  // 来源德系模块code
  sourceId      String?  // 来源记录ID
  version       Int      @default(1)   // 版本号，用于热更新
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  connections   PlugConnection[]
}

// 插槽 — 实际的插槽实例（每个显示位、渲染位都是一个插槽）
model Socket {
  id             String   @id @default(cuid())
  code           String   @unique     // 唯一标识（如 display_value_unit, render_moral_radar）
  name           String
  description    String?
  socketTypeCode String                // 插槽型号
  socketType     SocketType @relation(fields: [socketTypeCode], references: [code])
  consumer       String                // 消费者模块（如 moral-equity-page, ledger-page）
  location       String?  // JSON — 插槽位置描述 {page, component, area, slot}
  requiredPlugType String? // 强制要求某种型号的插头
  isRequired     Boolean  @default(false) // 是否必须插入
  allowMultiple  Boolean  @default(false) // 是否允许同时插入多个插头
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  connections    PlugConnection[]
}

// 插头连接 — 记录哪个插头插入了哪个插槽
model PlugConnection {
  id              String    @id @default(cuid())
  plugId          String
  plug            Plug      @relation(fields: [plugId], references: [id])
  socketId        String
  socket          Socket    @relation(fields: [socketId], references: [id])
  status          String    @default("active")  // active/disconnected/error
  transformResult String?   // JSON — 通过兼容规则transform后的最终值
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  signalChannel   String?   // 连接对应的神经信号频道
}
