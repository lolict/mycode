generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatar        String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdProjects Project[]
  donations     Donation[]
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  icon        String?
  projects    Project[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String
  targetAmount Float
  currentAmount Float  @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  status      String   @default("pending")
  images      String?
  location    String?
  organizer   String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  donations   Donation[]
  donorCount  Int      @default(0)
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  message   String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  donorId   String
  donor     User     @relation(fields: [donorId], references: [id])
}

model DexiModule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  fullName    String
  category    String
  description String
  icon        String
  color       String
  features    String   // JSON string
  status      String   @default("active")
  priority    Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     DexiRecord[]
}

model DexiRecord {
  id         String   @id @default(cuid())
  moduleCode String
  module     DexiModule @relation(fields: [moduleCode], references: [code])
  userId     String?
  title      String
  content    String   // JSON string - flexible per module
  value      Float    @default(0)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NamedLedger {
  id          String   @id @default(cuid())
  ledgerType  String
  content     String
  value       Float    @default(0)
  status      String   @default("pending")
  userId      String?
  specialData String?  // JSON string
  tags        String?  // JSON string
  privacy     String   @default("private")
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  projectId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectDocument {
  id        String   @id @default(cuid())
  docType   String
  content   String
  isPublic  Boolean  @default(false)
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
