generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  avatar           String?
  phone            String?
  userType         String   @default("disabled")  // disabled=残疾人, able-bodied=健全人
  communityBalance Float    @default(0)            // 共同体账户余额
  investmentPoints Float    @default(0)            // 投资点数
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdProjects  Project[]
  donations        Donation[]
  namedLedgers     NamedLedger[]
  comments         Comment[]
  communityAccounts CommunityAccount[]
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  icon        String?
  projects    Project[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String
  targetAmount Float
  currentAmount Float  @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  status      String   @default("pending")
  images      String?
  location    String?
  organizer   String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  donations   Donation[]
  donorCount  Int      @default(0)
  comments    Comment[]
  documents   ProjectDocument[]
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  message   String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  donorId   String
  donor     User     @relation(fields: [donorId], references: [id])
}

// ============================================
// 评论系统
// ============================================

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

// ============================================
// 项目文档系统
// ============================================

model ProjectDocument {
  id        String   @id @default(cuid())
  docType   String   // 文档类型
  content   String?  // 文档内容
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

// ============================================
// 记名账本系统 - Named Ledger
// ============================================
// 账本类型：technology/technique/public_tool/intelligence/energy/charity/donation/volunteer/time/deposit/cooperation/dream/reality/medical

model NamedLedger {
  id          String   @id @default(cuid())
  ledgerType  String   // 账本类型
  content     String   // 内容描述
  value       Float    @default(0)  // 价值评分
  status      String   @default("pending")  // pending/confirmed/rejected
  specialData String?  // JSON格式特殊数据
  tags        String?  // JSON格式标签
  privacy     String   @default("private")  // private/public
  projectId   String?  // 关联项目ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

// ============================================
// 共同体账户系统 - Community Account
// ============================================

model CommunityAccount {
  id             String   @id @default(cuid())
  accountType    String   // balance=余额, investment=投资
  amount         Float    @default(0)
  reason         String?  // 变动原因
  transactionType String  // credit=收入, debit=支出
  createdAt      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

// ============================================
// 创新创意归档分类系统 - Innovation Archive
// ============================================

model Idea {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?

  // 分类向量特征
  layer       String   @default("DRAFT")
  maturity    String   @default("DRAFT")
  domain      String?
  subDomain   String?

  // 向量化特征
  featureVector String?
  keywords    String?

  // 优先级与紧急度
  priority    Int      @default(5)
  urgency     Int      @default(5)
  effort      Int      @default(5)

  // 依赖与被依赖
  sourceRelations IdeaRelation[] @relation("SourceIdea")
  targetRelations IdeaRelation[] @relation("TargetIdea")

  // 标签
  tagRelations  IdeaTagRelation[]

  // 状态
  isArchived  Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  blockReason String?

  // 时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联项目
  projectId   String?
}

model IdeaRelation {
  id           String   @id @default(cuid())
  type         String

  sourceIdeaId String
  sourceIdea   Idea     @relation(fields: [sourceIdeaId], references: [id], name: "SourceIdea")
  targetIdeaId String
  targetIdea   Idea     @relation(fields: [targetIdeaId], references: [id], name: "TargetIdea")

  strength     Float    @default(0.5)
  description  String?
  distance     Float?

  createdAt    DateTime @default(now())
}

model IdeaTag {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?
  color       String?
  description String?

  ideas       IdeaTagRelation[]
  createdAt   DateTime @default(now())
}

model IdeaTagRelation {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  tagId     String
  tag       IdeaTag  @relation(fields: [tagId], references: [id])
  weight    Float    @default(1.0)

  createdAt DateTime @default(now())

  @@unique([ideaId, tagId])
}
